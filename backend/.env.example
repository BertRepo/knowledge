# ===== Internal AI (Anthropic-compatible) =====
# Root of the endpoint WITHOUT a trailing slash. The client POSTs to
# {AI_BASE_URL}{AI_API_PATH} (default path = /v1/messages).
# Auth: the client sends BOTH x-api-key and Authorization: Bearer headers,
# so a Ccswitch-style ANTHROPIC_AUTH_TOKEN (ck_...) works directly here.
AI_BASE_URL=https://your-internal-ai.example.com
AI_API_PATH=/v1/messages
AI_API_KEY=replace-with-your-token-or-private-key
AI_MODEL=claude-sonnet-5
# Anthropic protocol version header
AI_ANTHROPIC_VERSION=2023-06-01
# Max tokens for analysis responses. Reasoning models (e.g. doubao) emit
# "thinking" blocks that eat the budget; keep this generous (8192+).
AI_MAX_TOKENS=8192
# Request timeout (seconds)
AI_TIMEOUT=240

# ===== 笔记目录 =====
# .md 笔记写入位置。默认本地笔记目录。
# 可填 iCloud / Git 同步目录路径实现跨设备同步。
NOTES_DIR=f:/myWorkspacePrivate/knowledge/vault

# ===== Server / CORS =====
# Frontend origin allowed to call this backend
CORS_ORIGINS=http://localhost:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
