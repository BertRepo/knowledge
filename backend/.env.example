# ===== LLM 选择 =====
# online=云端 API，local=本地 llama.cpp，none=未配置
LLM_PROVIDER=online

# ===== 在线 LLM API（云端大模型）=====
# 请求/响应格式：anthropic（/v1/messages）或 openai（/v1/chat/completions）
LLM_API_FORMAT=anthropic
# 端点根地址（不带尾斜杠），客户端请求 {LLM_BASE_URL}{LLM_API_PATH}
LLM_BASE_URL=https://api.anthropic.com
LLM_API_PATH=/v1/messages
LLM_API_KEY=replace-with-your-key
LLM_MODEL=claude-sonnet-5
# 仅 anthropic 格式用
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ===== 本地 LLM（llama.cpp / llama-server，离线）=====
# llama-server 可执行文件路径（编译好的 llama.cpp）
# Windows 示例：F:/jackWorkspace/langchain-ai-RGA/llama-server/llama-server.exe
LOCAL_LLM_SERVER_PATH=
# GGUF 模型文件路径
# 示例：F:/jackWorkspace/langchain-ai-RGA/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_LLM_MODEL_PATH=
LOCAL_LLM_PORT=8080
# GPU 层数（0=纯 CPU；Mac Metal 可调大）
LOCAL_LLM_GPU_LAYERS=0
LOCAL_LLM_CTX_SIZE=4096

# ===== 应用配置 =====
# 笔记目录（纯 Markdown，可填 iCloud/Git 同步路径）
NOTES_DIR=f:/myWorkspacePrivate/knowledge/vault
CORS_ORIGINS=http://localhost:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ===== 向量检索（embedding，独立于 LLM）=====
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
