{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "知识聚合器",
  "version": "1.0.0",
  "identifier": "com.knowledge-aggregator.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cross-env TAURI_BUILD=1 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "知识聚合器",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/local-model/llama-server/": "local-model/llama-server/",
      "../../backend/local-model/qwen2.5-1.5b-instruct-q4_k_m.gguf": "local-model/qwen2.5-1.5b-instruct-q4_k_m.gguf",
      "knowledge-backend.exe": "knowledge-backend.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
